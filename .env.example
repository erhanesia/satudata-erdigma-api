# =============================================================================
# TEMPLATE variabel lingkungan.
#
# Berkas ini hanya contoh — TIDAK dibaca aplikasi maupun Docker Compose.
# Salin lebih dulu menjadi `.env`, lalu isi nilainya:
#
#   Windows PowerShell : Copy-Item .env.example .env
#   Git Bash / Linux   : cp .env.example .env
#
# `.env` berisi nilai asli dan TIDAK ikut git.
# `.env.example` ikut git — JANGAN pernah menuliskan nilai asli di sini.
# =============================================================================


# --- Profil Spring -----------------------------------------------------------
# Menentukan konfigurasi mana yang dipakai saat aplikasi start.
# Isi dengan:
#   dev,auth-dummy  → pengembangan di laptop (autentikasi disamarkan)
#   prod            → produksi (wajib Cognito, auth-dummy ditolak)
spring_profiles_active=


# --- Postgres lokal ----------------------------------------------------------
# Kredensial container Postgres bersama (lihat compose.yaml). Nilai ini juga
# yang dipakai Docker Compose saat membuat container, jadi keduanya harus sama.
#
# DB_HOST     → alamat server database. Untuk lokal: localhost
# DB_PORT     → port di sisi host. Untuk lokal: 5433
#               (5432 dipakai PostgreSQL native yang biasanya sudah terinstal)
# DB_NAME     → nama database. Untuk proyek ini: satudata
# DB_USERNAME → user database. Bawaan container: postgres
# DB_PASSWORD → password database. Bebas, asal konsisten. Bawaan: postgres
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=


# --- Database produksi -------------------------------------------------------
# Hanya terpakai bila spring_profiles_active=prod. Kosongkan saat lokal.
# Minta nilainya ke tim infrastruktur — jangan menebak sendiri.
#
# PROD_DB_HOST     → endpoint RDS, mis. xxx.ap-southeast-1.rds.amazonaws.com
# PROD_DB_PORT     → umumnya 5432
# PROD_DB_NAME     → nama database produksi
# PROD_DB_USERNAME → user aplikasi (bukan user master)
# PROD_DB_PASSWORD → ambil dari secret manager, jangan disimpan di catatan
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_NAME=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=


# --- AWS Cognito -------------------------------------------------------------
# Dipakai saat integrasi HRIS. Kosongkan selama masih profil auth-dummy.
#
# COGNITO_REGION       → region AWS, mis. ap-southeast-1
# COGNITO_USER_POOL_ID → ID user pool, bentuknya <region>_<9 karakter acak>
# COGNITO_ISSUER_URI   → https://cognito-idp.<region>.amazonaws.com/<user pool id>
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_ISSUER_URI=


# --- HRIS API ----------------------------------------------------------------
# Basis URL layanan HRIS, tanpa garis miring di akhir.
# Diisi saat integrasi; kosongkan sebelum itu.
HRIS_BASE_URL=


# --- Lain-lain ---------------------------------------------------------------
# SHOW_SQL → true menampilkan query Hibernate di log. Berguna saat menelusuri
#            masalah query, tapi berisik. Isi false untuk pemakaian normal.
# STAGE    → penanda lingkungan. Isi salah satu: dev | staging | prod
SHOW_SQL=
STAGE=
